# Copy to .env (never commit it). All values are optional.
API_PORT=8787
# LLM provider: anthropic | openai-compatible | none
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# OpenAI-compatible endpoint (Ollama, LM Studio, OpenRouter, OpenAI...)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# Optional market-data fallback for indices/ETFs when Yahoo Finance is rate limited
TWELVEDATA_API_KEY=
