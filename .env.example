# Copy to .env (never commit it). All values are optional.
API_PORT=8787
# LLM provider: gemini | anthropic | openai-compatible | none (default: gemini if GEMINI_API_KEY is set, else anthropic)
LLM_PROVIDER=
# Free Google Gemini key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Second Gemini analyst on the same key (a different model votes separately); "off" to disable
GEMINI_SECOND_MODEL=gemini-3.1-flash-lite

# ── Trade analyst panel: every key below adds one more free AI analyst to the vote ──
# Model names are optional: when empty the app asks the provider for its models and picks a strong one.
# Groq (free, no card): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=
# Cerebras (free, no card): https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
# Mistral (free "Experiment" plan): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# OpenRouter (free ":free" models, ~50 requests/day): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# GitHub Models (free with a GitHub account; fine-grained token with the "models" permission)
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini
# Hugging Face (small free monthly credit): https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL=
# Ollama on this computer (free, private): install from https://ollama.com, then e.g. OLLAMA_MODEL=qwen3:8b
OLLAMA_MODEL=
OLLAMA_BASE_URL=
# Leave analysts out of the panel, e.g. AI_ANALYSTS_OFF=anthropic (when the account has no credit)
AI_ANALYSTS_OFF=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# OpenAI-compatible endpoint (Ollama, LM Studio, OpenRouter, OpenAI...)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# Optional market-data fallback for indices/ETFs when Yahoo Finance is rate limited
TWELVEDATA_API_KEY=
# Enables the Administrator page (/api/admin/*). Leave empty to disable. Use a long random value.
ADMIN_TOKEN=
