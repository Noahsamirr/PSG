{
  "name": "pine-forge",
  "version": "0.1.0",
  "private": true,
  "description": "Pine Script v6 strategy/indicator generator, validator, consensus engine and TradingView launcher",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen": "tsx scripts/generate-all.ts",
    "docs:catalog": "tsx scripts/gen-catalog-doc.ts",
    "rank": "tsx scripts/rank-market.mts",
    "lint:generated": "tsx scripts/generate-all.ts && tsx scripts/lint-all.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@uiw/react-codemirror": "^4.25.12",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "lightweight-charts": "^5.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
